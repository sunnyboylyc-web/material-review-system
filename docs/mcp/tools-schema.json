{
  "schemaVersion": "material-review-mcp-tools-snapshot-1.1.0",
  "transport": "streamable-http",
  "protocolVersionVerified": "2025-11-25",
  "serverInfo": {
    "name": "Material Review System",
    "version": "1.2.2"
  },
  "authentication": "bearer",
  "source": "Generated from MCP tools/list; verify against the connected server on each connection.",
  "tools": [
    {
      "name": "get_data_guide",
      "description": "无需参数。接入/复盘前读取：连接认证、调用顺序、日期约束、指标单位/公式、覆盖与未知/部分值、分组、分页/报告有效期及兼容版本。也可读资源dashboard://guide。",
      "inputSchema": {
        "properties": {},
        "title": "get_data_guideArguments",
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "get_data_guideDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "list_projects",
      "description": "无需参数。列出有权复盘的启用项目projects[]，将id原样用于project_id；name仅作显示，不要猜ID。返回dataMode并标明真实/合成来源，不返回广告账户配置或凭据。",
      "inputSchema": {
        "properties": {},
        "title": "list_projectsArguments",
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "list_projectsDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_period_review",
      "description": "必填query对象：project_id（来自list_projects）、本期current_start/current_end、上期previous_start/previous_end四个日期，均YYYY-MM-DD/北京时间/含首尾。每区间开始≤结束且≤3660天；可选两对素材测试日期，不填默认对应统计周期，仅影响05—06/AI。读取01—06及AI看板、coverage/指标状态，不需网页刷新或保存；返回reportId供同版本明细/趋势，最长900秒。跨字段日期关系由服务端校验。",
      "inputSchema": {
        "$defs": {
          "PeriodQuery": {
            "additionalProperties": false,
            "properties": {
              "project_id": {
                "description": "先调用list_projects，从projects[].id原样取得；不是广告账户ID、抖音号或项目显示名称。",
                "pattern": "^[A-Za-z0-9_-]{1,100}$",
                "title": "Project Id",
                "type": "string"
              },
              "current_start": {
                "description": "必填：本期统计开始日，含当天。与current_end组成闭区间，最多3660个自然日。",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "title": "Current Start",
                "type": "string"
              },
              "current_end": {
                "description": "必填：本期统计结束日，含当天；不得早于current_start。",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "title": "Current End",
                "type": "string"
              },
              "previous_start": {
                "description": "必填：上期统计开始日，含当天。与previous_end组成闭区间，最多3660个自然日。",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "title": "Previous Start",
                "type": "string"
              },
              "previous_end": {
                "description": "必填：上期统计结束日，含当天；不得早于previous_start。上期/本期不强制等长、不强制先后或不重叠。",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "title": "Previous End",
                "type": "string"
              },
              "current_test_start": {
                "anyOf": [
                  {
                    "description": "YYYY-MM-DD真实自然日，年份1900—2200，北京时间Asia/Shanghai，起止当日均包含。",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "可选：本期素材测试开始日，必须与current_test_end成对填非空值；两者省略或均null则默认本期统计起止。仅影响05—06及AI类型统计。",
                "title": "Current Test Start"
              },
              "current_test_end": {
                "anyOf": [
                  {
                    "description": "YYYY-MM-DD真实自然日，年份1900—2200，北京时间Asia/Shanghai，起止当日均包含。",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "可选：本期素材测试结束日，含当天，不早于测试开始，最长3660天；可早于或超出本期统计范围。",
                "title": "Current Test End"
              },
              "previous_test_start": {
                "anyOf": [
                  {
                    "description": "YYYY-MM-DD真实自然日，年份1900—2200，北京时间Asia/Shanghai，起止当日均包含。",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "可选：上期素材测试开始日，与previous_test_end成对；两者省略或均null默认上期统计起止。",
                "title": "Previous Test Start"
              },
              "previous_test_end": {
                "anyOf": [
                  {
                    "description": "YYYY-MM-DD真实自然日，年份1900—2200，北京时间Asia/Shanghai，起止当日均包含。",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "可选：上期素材测试结束日，含当天，不早于测试开始，最长3660天。不是Excel文件上传日期。",
                "title": "Previous Test End"
              },
              "top_limit": {
                "default": 10,
                "description": "看板TOP展示数量，默认10、1—200整数；不限制query_materials的完整候选范围。",
                "maximum": 200,
                "minimum": 1,
                "title": "Top Limit",
                "type": "integer"
              }
            },
            "required": [
              "project_id",
              "current_start",
              "current_end",
              "previous_start",
              "previous_end"
            ],
            "title": "PeriodQuery",
            "type": "object"
          }
        },
        "properties": {
          "query": {
            "$ref": "#/$defs/PeriodQuery"
          }
        },
        "required": [
          "query"
        ],
        "title": "get_period_reviewArguments",
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "get_period_reviewDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "query_materials",
      "description": "必填query.report_id。在同报告完整候选内先筛名称/ID/指标再分页，默认20最多100条，百分比筛选3代表3%；类型/AI子组可筛cpc，整体/新老组未提供该字段会拒绝。用nextOffset续页、null结束，父汇总不变；每日来源仅TOP200候选。报告过期/淘汰须重建并清空旧分页。",
      "inputSchema": {
        "$defs": {
          "ColumnFilter": {
            "additionalProperties": false,
            "properties": {
              "field": {
                "description": "筛选字段；各组可用字段见get_data_guide.filterFields。百分比字段筛选输入3代表3%，金额元，ROI倍数，creationDate为YYYY-MM-DD。",
                "enum": [
                  "currentSpend",
                  "previousSpend",
                  "roi",
                  "ctr",
                  "cvr",
                  "cpm",
                  "cpc",
                  "creationDate",
                  "spendShare",
                  "dayRoi",
                  "annualRoi",
                  "windowRoi",
                  "recent3Orders",
                  "recent3Spend",
                  "recent3Cpc",
                  "recent3Cpm",
                  "recent3Roi",
                  "lifetimeSpend",
                  "lifetimeRoi",
                  "windowSpend",
                  "recent3Impressions",
                  "recent3Clicks",
                  "recent3Ctr",
                  "recent3Cvr"
                ],
                "title": "Field",
                "type": "string"
              },
              "operator": {
                "description": "eq/ne/gt/gte/lt/lte需value；between需value和to且value≤to；in需非空values；status需非空statuses。多个列筛选为AND。",
                "enum": [
                  "eq",
                  "ne",
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "between",
                  "in",
                  "status"
                ],
                "title": "Operator",
                "type": "string"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "比较值，或between下界；按field采用数字或日期，不允许布尔值或非有限数字。",
                "title": "Value"
              },
              "to": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "仅between使用的闭区间上界。",
                "title": "To"
              },
              "values": {
                "default": [],
                "description": "默认空数组；in匹配列表，使用in时至少1项、最多30项。",
                "items": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "maxItems": 30,
                "title": "Values",
                "type": "array"
              },
              "statuses": {
                "default": [],
                "description": "默认空数组；status状态列表，使用status时非空，最多10项；允许VALID/UNKNOWN_INPUT/ZERO_DENOMINATOR/INVALID_INPUT/VERIFIED/INCOMPLETE/NOT_APPLICABLE/UNKNOWN。",
                "items": {
                  "type": "string"
                },
                "maxItems": 10,
                "title": "Statuses",
                "type": "array"
              }
            },
            "required": [
              "field",
              "operator"
            ],
            "title": "ColumnFilter",
            "type": "object"
          },
          "MaterialQuery": {
            "additionalProperties": false,
            "properties": {
              "report_id": {
                "description": "get_period_review或get_daily_top返回的reportId；同一报告后续查询使用同值，最长900秒，可能提前淘汰，失效重新获取报告并从首页开始。",
                "pattern": "^[a-f0-9]{32}$",
                "title": "Report Id",
                "type": "string"
              },
              "group": {
                "default": "overall",
                "description": "报告内分组，须在availableGroups中存在；daily报告仅overall。aigc是原有AIGC集合分组，不等于新增名称含AI的总汇。",
                "enum": [
                  "overall",
                  "new",
                  "historical",
                  "aigc",
                  "original",
                  "mixed",
                  "other",
                  "business",
                  "department"
                ],
                "title": "Group",
                "type": "string"
              },
              "search": {
                "default": "",
                "description": "素材名称或素材ID，不区分大小写的包含匹配，最多200字符；先筛全部候选，再分页。",
                "maxLength": 200,
                "title": "Search",
                "type": "string"
              },
              "filters": {
                "default": [],
                "description": "默认空数组，最多20个指标条件，全部同时生效；条件操作数依operator变化，跨字段关系由服务端校验。",
                "items": {
                  "$ref": "#/$defs/ColumnFilter"
                },
                "maxItems": 20,
                "title": "Filters",
                "type": "array"
              },
              "offset": {
                "default": 0,
                "description": "首请求0；继续使用nextOffset，返回null表示结束，不得混合不同reportId的分页。",
                "maximum": 100000,
                "minimum": 0,
                "title": "Offset",
                "type": "integer"
              },
              "page_size": {
                "default": 20,
                "description": "单页1—100条，默认20；同时受2MiB响应上限约束。",
                "maximum": 100,
                "minimum": 1,
                "title": "Page Size",
                "type": "integer"
              },
              "include_daily_spend": {
                "default": false,
                "description": "默认不附逐日消耗，true会增大响应；可改用get_material_trend读取单素材。",
                "title": "Include Daily Spend",
                "type": "boolean"
              }
            },
            "required": [
              "report_id"
            ],
            "title": "MaterialQuery",
            "type": "object"
          }
        },
        "properties": {
          "query": {
            "$ref": "#/$defs/MaterialQuery"
          }
        },
        "required": [
          "query"
        ],
        "title": "query_materialsArguments",
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "query_materialsDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_material_trend",
      "description": "必填report_id和material_id，group可选默认overall。读取同报告指定素材的来源指标及逐日消耗dailySpend；保留未知/覆盖状态，不提供每日ROI/订单等不存在的序列。报告失效重建整轮。",
      "inputSchema": {
        "properties": {
          "report_id": {
            "description": "get_period_review或get_daily_top返回的reportId；同一报告后续查询使用同值，最长900秒，可能提前淘汰，失效重新获取报告并从首页开始。",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Report Id",
            "type": "string"
          },
          "material_id": {
            "description": "从query_materials.rows[].materialId原样取得，必须属于该report_id和group，不能用素材名称代替。",
            "title": "Material Id",
            "type": "string"
          },
          "group": {
            "default": "overall",
            "description": "与取得该素材的明细分组一致，默认overall。",
            "enum": [
              "overall",
              "new",
              "historical",
              "aigc",
              "original",
              "mixed",
              "other",
              "business",
              "department"
            ],
            "title": "Group",
            "type": "string"
          }
        },
        "required": [
          "report_id",
          "material_id"
        ],
        "title": "get_material_trendArguments",
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "get_material_trendDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_daily_top",
      "description": "必填project_id（list_projects取得）和date（YYYY-MM-DD北京时间自然日）；limit默认10、1—200。读取每日TOP看板并返回reportId供明细/趋势；仅TOP200候选，不能当完整项目素材搜索。",
      "inputSchema": {
        "properties": {
          "project_id": {
            "description": "先调用list_projects，从projects[].id原样取得；不是广告账户ID、抖音号或项目显示名称。",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Project Id",
            "type": "string"
          },
          "date": {
            "description": "YYYY-MM-DD真实自然日，年份1900—2200，北京时间Asia/Shanghai，起止当日均包含。",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "Date",
            "type": "string"
          },
          "limit": {
            "default": 10,
            "description": "显示数量，整数1—200，默认10；候选始终只限上游TOP200。",
            "maximum": 200,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "project_id",
          "date"
        ],
        "title": "get_daily_topArguments",
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "get_daily_topDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_project_freshness",
      "description": "必填project_id（list_projects取得）。读取最近自动来源统计日；不是最后采集运行时间，也不涵盖人工最新日期或证明中间无缺日。完整性须读取周期coverage/missingDates，不用此接口判断调度健康。",
      "inputSchema": {
        "properties": {
          "project_id": {
            "description": "先调用list_projects，从projects[].id原样取得；不是广告账户ID、抖音号或项目显示名称。",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Project Id",
            "type": "string"
          }
        },
        "required": [
          "project_id"
        ],
        "title": "get_project_freshnessArguments",
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "get_project_freshnessDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    }
  ]
}
